# Apache / cPanel configuration for this single-page app.
# Vite copies everything in public/ into dist/, so this ships with the build.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # A missing static file must 404, not fall through to the SPA. Otherwise a
  # mistyped image or font path returns index.html with a 200 and an HTML
  # content type, so the browser neither loads it nor cleanly errors — the
  # failure is invisible until someone notices a blank space on the page.
  RewriteCond %{REQUEST_URI} \.(?:svg|png|jpe?g|gif|webp|avif|ico|css|js|mjs|map|woff2?|ttf|eot|mp4|webm|pdf|txt|xml|json)$ [NC]
  RewriteRule ^ - [L]

  # Every route except /, /services, /projects, /about and /contact exists only
  # in the browser. Without this fallback, loading or refreshing any of them
  # directly returns a 404 from the server.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Asset filenames carry a content hash, so they can be cached hard.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType video/mp4             "access plus 1 month"
  ExpiresByType font/woff2            "access plus 1 year"

  # index.html must never be cached — it points at the hashed assets.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
